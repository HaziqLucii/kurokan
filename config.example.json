{
  "$schema": "https://raw.githubusercontent.com/HaziqLucii/kurokan/main/docs/config.schema.json",
  "version": 2,
  "pollIntervalSec": 30,
  "theme": "system",
  "hosts": [
    {
      "id": "webdock",
      "provider": "webdock",
      "slug": "webdock-prod-01",
      "apiToken": "your-webdock-api-token"
    }
  ],
  "uptime": [
    {
      "id": "kuma",
      "provider": "kuma",
      "url": "https://status.example.tld",
      "apiKey": "uk1_your-uptime-kuma-api-key"
    }
  ],
  "containers": [
    {
      "id": "docker",
      "provider": "docker",
      "endpoint": "auto"
    }
  ],
  "history": { "retentionHours": 24 },
  "notifications": { "enabled": false },
  "layout": { "order": [], "incidents": true }
}
